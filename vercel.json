{
  "functions": {
    "api/lobby.ts": { "memory": 256, "maxDuration": 10 },
    "api/cloud-save.ts": { "memory": 256, "maxDuration": 10 },
    "api/bo3-edits.ts": { "memory": 256, "maxDuration": 10 },
    "api/og-pickem.ts": { "memory": 512, "maxDuration": 10, "includeFiles": "{server/og-assets/*.ttf,src/data/major-singapore-2026.json,public/logos/*,node_modules/harfbuzzjs/hb.wasm,node_modules/@resvg/resvg-wasm/index_bg.wasm}" },
    "api/og-pickem-page.ts": { "memory": 128, "maxDuration": 10, "includeFiles": "src/data/major-singapore-2026.json" },
    "api/*.ts": { "memory": 128, "maxDuration": 10 }
  },
  "crons": [
    { "path": "/api/cron?job=wl-settle", "schedule": "5 3 * * 0" }
  ],
  "rewrites": [
    { "source": "/jogar", "destination": "/" },
    { "source": "/criar-manager", "destination": "/" },
    { "source": "/perfil", "destination": "/" },
    { "source": "/ranking", "destination": "/" },
    { "source": "/privacidade", "destination": "/" },
    { "source": "/termos", "destination": "/" },
    { "source": "/reembolso", "destination": "/" },
    { "source": "/online", "destination": "/" },
    { "source": "/online/:path*", "destination": "/" },
    { "source": "/ultimateteam", "destination": "/" },
    { "source": "/ultimate-team", "destination": "/" },
    { "source": "/ultimate", "destination": "/" },
    { "source": "/road-to-pro", "destination": "/" },
    { "source": "/diario", "destination": "/" },
    { "source": "/carreira", "destination": "/" },
    { "source": "/carreira/:path*", "destination": "/" },
    { "source": "/editor", "destination": "/" },
    { "source": "/hall", "destination": "/" },
    { "source": "/banners", "destination": "/" },
    { "source": "/design", "destination": "/" },
    {
      "source": "/major-singapore",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*([Tt]witter[Bb]ot|[Ff]acebook[Ee]xternal[Hh]it|[Ww]hats[Aa]pp|[Dd]iscord[Bb]ot|[Tt]elegram[Bb]ot|[Ss]lack[Bb]ot|[Ll]inked[Ii]n[Bb]ot|[Ee]mbedly|[Ss]kype[Uu]ri[Pp]review).*" },
        { "type": "query", "key": "p" }
      ],
      "destination": "/api/og-pickem-page"
    },
    { "source": "/major-singapore", "destination": "/" },
    { "source": "/jogo/:path*", "destination": "/" },
    { "source": "/admin", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/maps/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/logos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(favicon.png|icons.svg|og.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/ads/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), usb=(), browsing-topics=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' https://platform.twitter.com https://cdn.syndication.twimg.com https://www.googletagmanager.com https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' data: blob: https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://vercel.live; frame-src https://platform.twitter.com https://syndication.twitter.com https://vercel.live; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/error?csp=1" }
      ]
    }
  ]
}
